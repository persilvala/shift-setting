generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Employee {
  id             Int            @id @default(autoincrement())
  employeeName   String         @unique
  basePayPerDay  Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  payrollEntries PayrollEntry[]
  timesheetRows  TimesheetRow[]

  @@index([employeeName])
}

model Timesheet {
  id          Int            @id @default(autoincrement())
  fileName    String?
  format      String
  startDate   DateTime
  endDate     DateTime
  totalRows   Int
  uploadedAt  DateTime       @default(now())
  entrySource String?        @default("upload")
  payrolls    Payroll[]
  rows        TimesheetRow[]

  @@index([uploadedAt])
}

model TimesheetRow {
  id               Int            @id @default(autoincrement())
  timesheetId      Int
  employeeId       Int?
  employeeName     String
  userId           String?
  date             DateTime
  weekday          String?
  dept             String?
  beforeNoonIn     String?
  beforeNoonOut    String?
  afterNoonIn      String?
  afterNoonOut     String?
  overtimeIn       String?
  overtimeOut      String?
  totalHours       Float?
  lateMinutes      Int?
  earlyMinutes     Int?
  workHours        Float?
  workHoursActual  Float?
  overtimeHours    Float?
  workDays         String?
  tripDays         Float?
  absenceDays      Float?
  leaveDays        Float?
  addPayNormal     Float?
  addPayOvertime   Float?
  addPayAllowance  Float?
  payrollDeduction Float?
  shiftCode        String?
  remark           String?
  attendanceStatus String         @default("full_day")
  createdAt        DateTime       @default(now())
  payrollEntries   PayrollEntry[]
  employee         Employee?      @relation(fields: [employeeId], references: [id])
  timesheet        Timesheet      @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([timesheetId])
  @@index([employeeName])
  @@index([employeeId])
  @@index([date])
}

model Payroll {
  id            Int            @id @default(autoincrement())
  timesheetId   Int?
  startDate     DateTime
  endDate       DateTime
  basePayPerDay Float
  totalNetPay   Float
  isEdited      Boolean        @default(false)
  generatedAt   DateTime       @default(now())
  timesheet     Timesheet?     @relation(fields: [timesheetId], references: [id])
  entries       PayrollEntry[]

  @@index([generatedAt])
}

model PayrollEntry {
  id              Int           @id @default(autoincrement())
  payrollId       Int
  timesheetRowId  Int?
  employeeId      Int
  attendanceDays  Int           @default(0)
  halfDays        Int           @default(0)
  absentDays      Int           @default(0)
  basePay         Float         @default(0)
  addedValue      Float         @default(0)
  subtractedValue Float         @default(0)
  netPay          Float         @default(0)
  isEdited        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  note            String?
  noteCreatedBy   String?
  noteCreatedAt   DateTime?
  noteEditedBy    String?
  noteEditedAt    DateTime?
  employee        Employee      @relation(fields: [employeeId], references: [id])
  payroll         Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  timesheetRow    TimesheetRow? @relation(fields: [timesheetRowId], references: [id])

  @@index([payrollId])
  @@index([employeeId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  admin        Admin    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
